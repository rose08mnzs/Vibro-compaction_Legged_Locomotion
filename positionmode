#include <DynamixelShield.h>

#if defined(ARDUINO_AVR_UNO) || defined(ARDUINO_AVR_MEGA2560)
  #include <SoftwareSerial.h>
  SoftwareSerial soft_serial(7, 8); // DYNAMIXELShield UART RX/TX
  #define DEBUG_SERIAL soft_serial
#elif defined(ARDUINO_SAM_DUE) || defined(ARDUINO_SAM_ZERO)
  #define DEBUG_SERIAL SerialUSB    
#else
  #define DEBUG_SERIAL Serial
#endif

const uint8_t DXL_ID[] = {3,2,4,30};
const uint8_t NUM_DXL = sizeof(DXL_ID) / sizeof(DXL_ID[0]);
const float DXL_PROTOCOL_VERSION = 2.0;

DynamixelShield dxl;

//This namespace is required to use Control table item names
using namespace ControlTableItem;

void setup() {
  // put your setup code here, to run once:
  
  // For Uno, Nano, Mini, and Mega, use UART port of DYNAMIXEL Shield to debug.
  DEBUG_SERIAL.begin(115200);

  // Set Port baudrate to 57600bps. This has to match with DYNAMIXEL baudrate.
  dxl.begin(1000000);
  // Set Port Protocol Version. This has to match with DYNAMIXEL protocol version.
  dxl.setPortProtocolVersion(DXL_PROTOCOL_VERSION);
  // Get DYNAMIXEL information
  for (uint8_t i = 0; i < NUM_DXL; i++) {
    uint8_t id = DXL_ID[i];

    if (dxl.ping(id)) {
      DEBUG_SERIAL.print("Connected to DXL ID ");
      DEBUG_SERIAL.println(id);

      dxl.torqueOff(id);
      // dxl.setOperatingMode(id, OP_POSITION);
      // dxl.torqueOn(id);
    } else {
      DEBUG_SERIAL.print("Failed to connect to DXL ID ");
      DEBUG_SERIAL.println(id);
    }
  }
}

void loop() {
  // put your main code here, to run repeatedly:
  for (uint8_t i = 0; i < NUM_DXL; i++) {
    uint8_t id = DXL_ID[i];

    int pos_deg = dxl.getPresentPosition(id, UNIT_DEGREE);

    DEBUG_SERIAL.print("Motor ID ");
    DEBUG_SERIAL.print(id);
    DEBUG_SERIAL.print(": ");
    DEBUG_SERIAL.print(pos_deg);
    DEBUG_SERIAL.println(" deg");
  }

  DEBUG_SERIAL.println("--------------------");
  delay(1000);
}
